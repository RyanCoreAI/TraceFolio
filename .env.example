DEEPSEEK_API_KEY=your_deepseek_key
GITHUB_TOKEN=optional_github_token
POSTGRES_DB=tracefolio
POSTGRES_USER=tracefolio
POSTGRES_PASSWORD=tracefolio_password
# Comma-separated exact trusted HTTPS hosts, not wildcards. Disabled when empty.
TRACEFOLIO_BLOG_ALLOWED_HOSTS=
# Comma-separated operator-owned directories. Local scanning disabled when empty.
TRACEFOLIO_LOCAL_REPO_ALLOWED_ROOTS=
